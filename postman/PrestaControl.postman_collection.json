      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"nombre\": \"Prestamista A\", \"email\": \"prestamista_a@example.com\", \"password\": \"Password123\"}"
        },
        "url": {
          "raw": "{{base_url}}/auth/register",

    {
      "name": "05. Prestamos - Crear Prestamo (Usuario A)",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token_usuario_a}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"cliente\": \"Carlos Perez\", \"dni\": \"87654321\", \"monto\": 1000.0, \"interes\": 10.0, \"fechaVencimiento\": \"2026-12-30\"}"
        },
        "url": {
          "raw": "{{base_url}}/prestamos",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "prestamos"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 201', function () { pm.response.to.have.status(201); });",
              "var json = pm.response.json();",
              "pm.expect(json.totalCobrar).to.eql(1100.00);",
              "pm.environment.set('prestamo_id', json.id);"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },

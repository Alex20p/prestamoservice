# ==========================================
# Variables de Entorno - PrestaControl API
# ==========================================
# IMPORTANTE: Spring Boot no carga archivos .env automáticamente.
# Configura estas variables en IntelliJ IDEA:
# Run -> Edit Configurations -> Modify options -> Environment variables
# O en Render como Environment Variables en el panel de control.

# PostgreSQL en Render
DB_HOST=dpg-xxxxxxxxxxxx-a.oregon-postgres.render.com
DB_PORT=5432
DB_NAME=prestacontrol
DB_USER=prestacontrol_user
DB_PASSWORD=tu_password_aqui
DB_SSL_MODE=require

# Puerto del servidor (en Render se asigna automáticamente mediante PORT)
PORT=8080

# Seguridad JWT (Clave de al menos 256 bits codificada en Base64)
# Sustituye este marcador por una clave propia antes de ejecutar:
JWT_SECRET=REEMPLAZA_CON_TU_CLAVE_BASE64_DE_AL_MENOS_256_BITS
JWT_EXPIRATION=86400000
